{
    "name": "moment-orchestra/orchestra-management",
    "description": "Event management system for Moment Orchestra",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "composer",
            "url": "http://packagist.org"
        }
    ],
    "authors": [
        {
            "name": "Roxana",
            "email": "contact@momentorchestra.ro"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "MomentOrchestra\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "Tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "secure-http": false
    }
}